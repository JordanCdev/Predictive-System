rules_version = '2';

// Every document lives under users/{uid}/… and is readable/writable only by that
// signed-in user. Birth data never leaves the owner's account.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ONE rule covers the whole user tree, because Firestore rules are OR'd: a
    // separate `match /users/{uid}/{document=**}` granting write would re-open
    // the metering documents no matter what a narrower rule below it said. So the
    // exclusion lives inside the same condition as the grant.
    //
    // The `billing` collection now holds only the AI usage meter (the abuse
    // bound on the hosted proxy's token spend), and it is SERVER-OWNED — the
    // owner reads their meter, but only the chat function (Admin SDK, which
    // bypasses these rules entirely) may write it. Otherwise a user could zero
    // out their own usage counter.
    match /users/{uid}/{coll}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && coll != 'billing';
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
