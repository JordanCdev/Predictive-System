      "dayBranch": "辰",
      "readings": [
        {
          "hunt": 0,
          "witnesses": [
            "nlc416-wenming"
          ],
          "witnessAttribution": "tagged",
          "officer": "閉",
          "text": "戊辰甲辰煞入中宮。不利修造婚姻開張出行入宅安葬。犯之損人口。六畜不旺。財產有失。庚辰雖值月德。卻有天地轉煞之疑。丙辰壬辰火星。小小營爲則可。不宜婚姻起造移徙開張大作用也。",
          "variantNotes": []
        }
      ]
    },
