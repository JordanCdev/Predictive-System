            "nlc416-wenming",
            "nlc892-1898"
          ],
          "witnessAttribution": "tagged",
          "officer": "執",
          "text": "辛卯己卯有黃羅紫檀天皇地皇諸吉星。蓋照。宜嫁娶開張出行入宅動土修方起造倉庫。主進財產。增人口。興家道。旺六畜大吉。餘卯次吉。惟乙卯正四廢凶。",
          "variantNotes": [
