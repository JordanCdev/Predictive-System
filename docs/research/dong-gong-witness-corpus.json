          "witnesses": [
            "nlc892-1898"
          ],
          "witnessAttribution": "inferred",
          "officer": "平",
          "text": "朱雀勾絞。不利出行。起造。安葬。婚姻。入宅。主小人奉連。口舌。陰人小口生災。甲申。庚申煞入中宮更凶。主招官司禍事。破財。生子醜怪。有水火災厄。",
          "variantNotes": []
        }
      ]
