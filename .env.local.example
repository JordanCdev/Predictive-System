# .env.local.example — every environment variable this app reads, and what breaks
# without it. Copy to `.env.local` (gitignored) and fill in what you need.
#
# EVERY variable here is OPTIONAL. With none of them set the app still runs: the
# deterministic engine is fully client-side, profiles and journal live in
# localStorage, chat is BYOK, and everyone is on the Free plan. Each variable
# switches on one additional, additive capability.
#
# `VITE_`-prefixed values are BUNDLED INTO THE PUBLIC JAVASCRIPT. Never put a
# secret in one. Secrets live server-side only (see the bottom of this file).
#
# Safe for GitHub Pages: `.env.local` is gitignored and absent from CI, so the
# deploy workflow builds only from repository secrets — see
# .github/workflows/deploy-pages.yml and docs/FIREBASE_SETUP.md §4.


# ── AI chat — LOCAL DEV only ─────────────────────────────────────────────────
# The app deploys to GitHub Pages (a static host with no backend), so the LIVE
# site uses BYOK: each visitor pastes their own Anthropic key into the chat card
# and it stays in their browser (localStorage key `wei_ai_key` — a SECRET; it is
# never exported and never synced). There is no server key in production.

# Your Anthropic API key. Read ONLY by the dev proxy in vite.config.ts, server
# side; never bundled. WITHOUT IT: `npm run dev` chat falls back to BYOK, so you
# must paste a key into the browser to use chat locally. Nothing else breaks.
ANTHROPIC_API_KEY=sk-ant-...

# Points the app at an AI proxy. In dev, `/api/chat` is the middleware in
# vite.config.ts; in production it would be the deployed `chat` Cloud Function
# (which verifies the caller's Firebase ID token and meters usage).
# WITHOUT IT: chat is BYOK — fully functional, but each user needs their own key.
# Do NOT set this to /api/chat for a production build.
VITE_AI_PROXY_URL=/api/chat

# Dev server port. WITHOUT IT: defaults to 5173.
PORT=5173


# ── Firebase — accounts, cross-device sync, restorable subscriptions ─────────
# All six values are PUBLIC (the web apiKey is a project identifier, not a
# secret; access is controlled by Firestore rules + Auth). Get them from the
# Firebase console → Project settings → your web app, or `firebase apps:sdkconfig`.
#
# WITHOUT THEM (the current state): `firebaseEnabled` is false, the Firebase
# chunk never loads, there is NO SIGN-IN BUTTON anywhere, data lives only in this
# browser's localStorage, and a Pro subscription cannot be restored on another
# device. The app is otherwise complete.
#
# ⚠️ ALL SIX OR NONE. A partial set makes firebaseEnabled true with a broken
# config, which fails worse than leaving it off. See docs/FIREBASE_SETUP.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For the server-side AI: after deploying the Cloud Function, set VITE_AI_PROXY_URL
# (above) to its URL, e.g.
#   https://us-central1-your-project.cloudfunctions.net/chat


# ── Billing — Free/Pro subscriptions ─────────────────────────────────────────
# URL of the deployed `billing` Cloud Function (Stripe Checkout + customer portal).
# WITHOUT IT: the app runs Free-only and HIDES every upgrade affordance rather
# than offering a CTA that goes nowhere. Nothing is broken; nothing is sellable.
# Requires the Firebase block above (checkout needs a signed-in user's ID token).
# See docs/BILLING_SETUP.md.
VITE_BILLING_URL=

# DEV ONLY. Set to "pro" to unlock the paid surface locally so gated screens can
# be worked on without a real subscription (`npm run dev:pro` sets this for you).
# Read behind import.meta.env.DEV, so Vite strips it from any production build.
# WITHOUT IT: local dev is on the Free plan and Pro-gated screens show their gate.
VITE_DEV_FORCE_PLAN=


# ── Cloud Function environment (NOT read by the client) ──────────────────────
# Set on the functions, not here. Listed so the full surface is in one place.
#
#   REQUIRE_AUTH      chat function. Default "true" — verifies the caller's
#                     Firebase ID token. Set "false" ONLY for local function
#                     testing; "false" in production means anyone can spend your
#                     Anthropic key.
#   ALLOWED_ORIGINS   billing function. Comma-separated origin allowlist for CORS.
#                     Empty → requests from your deployed site may be rejected.
#
# Secrets live SERVER-side only, as Cloud Function secrets — never here, and
# never in a VITE_ variable (those are bundled into the public JS):
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# plus params STRIPE_PRICE_PRO_MONTH / STRIPE_PRICE_PRO_YEAR.
